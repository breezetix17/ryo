vertexlitgeneric
{
	$basetexture "models\weapons\shared\paracord\paracord01"
	"$bumpmap"                   "models\weapons\shared\paracord\paracord01_normal"
	"$phong"                     "1"
	"$phongboost"                "0.33"
	"$phongexponent"             "20"

	GPU<2
	{
		"$phong"		"0"
		"$envmap" 	""
		"$envmaptint" 	"[0 0 0]"
	}
	
	Proxies
	{
		TextureScroll
		{
			texturescrollvar $basetexturetransform
			texturescrollrate 10
			texturescrollangle -90
		}
		TextureScroll
		{
			texturescrollvar $bumptransform
			texturescrollrate 10
			texturescrollangle -90
		}
	}
	
}